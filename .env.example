# ==============================================================================
# Fintech Analytics Platform - Environment Configuration
# ==============================================================================

# Database Configuration
# Default: Zero-configuration SQLite (Ready out-of-the-box for evaluation)
USE_SQLITE=True
DATABASE_URL=sqlite:///./fintech.db

# Optional: PostgreSQL Production Mode (Uncomment below if using PostgreSQL)
# USE_SQLITE=False
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=fintech_user
# DB_PASSWORD=fintech_secret
# DB_NAME=fintech_analytics
# DATABASE_URL=postgresql://fintech_user:fintech_secret@localhost:5432/fintech_analytics

# Application Configuration
API_VERSION=1.0.0
LOG_LEVEL=INFO

# Local Open-Source LLM (Optional - defaults to autonomous rule engine if offline)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Storage Architecture
MODEL_REGISTRY_PATH=/app/models/registry
